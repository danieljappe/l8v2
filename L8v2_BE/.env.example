# Copy to .env and fill in. Never commit the filled-in file.

NODE_ENV=development
PORT=3000

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=l8v2

# --- Auth ---
# REQUIRED. The process refuses to start without it (src/config/env.ts).
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Billetto integration ---
# Only needed for sync/webhook endpoints; other routes start without them.
BILLETTO_API_KEY=
BILLETTO_API_SECRET=
BILLETTO_WEBHOOK_SECRET=
BILLETTO_API_BASE_URL=https://billetto.dk/api/v3

# --- Optional ---
# Global rate limit, requests per IP per 15 minutes (default 500).
RATE_LIMIT_MAX=500
