# Copy to .env and adjust. Only VITE_-prefixed vars reach the browser bundle.

# --- API -------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api

# --- Feature flags ---------------------------------------------------------
# L8 Booking (artist booking platform). The client paused it to focus on
# L8 Events, so it ships disabled: routes, nav entries, the platform-choice
# screen and the "Book Kunstnere" CTAs are all gated on this.
# Set to `true` and rebuild to bring the whole platform back.
#
# Read by the app via src/config/features.ts and by scripts/generate-sitemap.js
# (the sitemap script runs under plain Node, which does not load .env files —
# export the variable in the shell or CI when building with Booking enabled).
VITE_BOOKING_ENABLED=false
